# Railway HTTP port
HTTP_PORT=3000

# Railway TCP Proxy target
TCP_PORT=8080

# 3x-ui
XUI_PORT=2053

# Subscription server
SUB_PORT=2096

# WebSocket inbounds
WS_PORT_1=18080
WS_PORT_2=18081
WS_PORT_3=18082
WS_PORT_4=18083
WS_PORT_5=18084
WS_PORT_6=18085
WS_PORT_7=18086
WS_PORT_8=18087
WS_PORT_9=18088
WS_PORT_10=18089
WS_PORT_11=18090
WS_PORT_12=18091
WS_PORT_13=18092
WS_PORT_14=18093
WS_PORT_15=18094

# Paths
WS_PATH_1=/Cbee1
WS_PATH_2=/Cbee2
WS_PATH_3=/Cbee3
WS_PATH_4=/Cbee4
WS_PATH_5=/Cbee5
WS_PATH_6=/Cbee6
WS_PATH_7=/Cbee7
WS_PATH_8=/Cbee8
WS_PATH_9=/Cbee9
WS_PATH_10=/Cbee10
WS_PATH_11=/Cbee11
WS_PATH_12=/Cbee12
WS_PATH_13=/Cbee13
WS_PATH_14=/Cbee14
WS_PATH_15=/Cbee15

# Disable fail2ban inside Railway container
XUI_ENABLE_FAIL2BAN=false
